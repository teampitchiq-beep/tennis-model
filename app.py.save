import os
import math
import json
import sqlite3
from datetime import datetime, timezone
from flask import Flask, render_template_string, request
import requests

app = Flask(__name__)

SURFACES = {"hard", "clay", "grass"}
player_cache = {}
fixtures_cache = None
DB_PATH = os.path.join(os.path.dirname(os.path.abspath(__file__)), "odds.db")

# ---------- Bzzoiro config (corrected base URL) ----------
BZZOIRO_BASE = os.environ.get("BZZOIRO_BASE",
                              "https://sports.bzzoiro.com/tennis/api/v2")
BZZOIRO_TOKEN = os.environ.get("BZZOIRO_API_KEY")


def bzzoiro_get(endpoint, params=None):
    if not BZZOIRO_TOKEN:
        raise RuntimeError("BZZOIRO_API_KEY not set in environment.")
    headers = {"Authorization": f"Token {BZZOIRO_TOKEN}",
               "Accept": "application/json"}
    url = f"{BZZOIRO_BASE}{endpoint}"
    r = requests.get(url, headers=headers, params=params, timeout=20)
    if r.status_code == 401:
        raise RuntimeError("Bzzoiro 401: bad or missing token. "
                           "Send Authorization: Token <key>[reference:2].")
    if r.status_code == 402:
        raise RuntimeError("Bzzoiro 402: Sports Addon not active. "
                           "Tennis API requires the $5/mo Sports Addon[reference:3].")
    if r.status_code == 404:
        raise RuntimeError(f"Bzzoiro 404: endpoint not found. "
                           f"Check that the base URL includes /tennis/api/v2/. URL was: {url}")
    r.raise_for_status()
    return r.json()


# ---------- SQLite ----------
def init_db():
    conn = sqlite3.connect(DB_PATH)
    conn.execute("PRAGMA user_version = 2")
    conn.execute("""
        CREATE TABLE IF NOT EXISTS odds (
            match_id INTEGER PRIMARY KEY,
            mw1 REAL, mw2 REAL,
            s11 REAL, s12 REAL,
            line REAL, ov REAL, un REAL,
            updated_at TEXT
        )
    """)
    conn.commit()
    conn.close()


def ensure_schema():
    if not os.path.exists(DB_PATH):
        init_db()
        return
    conn = sqlite3.connect(DB_PATH)
    cur = conn.execute("PRAGMA user_version")
    if cur.fetchone()[0] < 2:
        conn.execute("DROP TABLE IF EXISTS odds")
        conn.commit()
    conn.close()
    init_db()


def save_odds(match_id, **v):
    cols = ["match_id", "mw1", "mw2", "s11", "s12", "line", "ov", "un", "updated_at"]
    vals = [match_id, v.get("mw1"), v.get("mw2"), v.get("s11"), v.get("s12"),
            v.get("line"), v.get("ov"), v.get("un"),
            datetime.now(timezone.utc).isoformat()]
    placeholders = ",".join("?" * len(cols))
    updates = ",".join(f"{c}=excluded.{c}" for c in cols if c != "match_id")
    conn = sqlite3.connect(DB_PATH)
    conn.execute(
        f"INSERT INTO odds ({','.join(cols)}) VALUES ({placeholders}) "
        f"ON CONFLICT(match_id) DO UPDATE SET {updates}", vals)
    conn.commit()
    conn.close()


def load_all_odds():
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    rows = conn.execute("SELECT * FROM odds").fetchall()
    conn.close()
    return {r["match_id"]: dict(r) for r in rows}


# ---------- Model ----------
def safe(d, *keys, default=None):
    cur = d
    for k in keys:
        if not isinstance(cur, dict):
            return default
        cur = cur.get(k)
        if cur is None:
            return default
    return cur


def elo_prob(e1, e2):
    return 1 / (1 + 10 ** ((e2 - e1) / 400))


def player_name(p):
    return (p.get("full_name") or p.get("name")
            or f"{p.get('first_name','')} {p.get('last_name','')}".strip()
            or "Unknown")


def player_rank(p):
    # Bzzoiro player detail exposes ranking under several possible keys
    return (safe(p, "current_ranking", "position")
            or safe(p, "current_ranking", "rank")
            or p.get("rank")
            or safe(p, "ranking", "position")
            or 500)


def player_points(p):
    return (safe(p, "current_ranking", "points")
            or p.get("ranking_points")
            or safe(p, "ranking", "points")
            or 0)


def player_rating(p):
    """Bzzoiro exposes ranking points; map to an Elo-like scale."""
    elo = p.get("elo") or safe(p, "stats", "elo", "overall")
    if elo:
        return float(elo)
    pts = player_points(p)
    # Scale: ~10,000 ATP pts ≈ 1750 Elo. Tune after seeing real data.
    return 1500 + float(pts) / 40.0


def total_games_model(elo_diff):
    ad = abs(elo_diff)
    p_3sets = 0.4 * math.exp(-ad / 200)
    closeness = max(0.0, 1 - ad / 400)
    base_2set = 19 + 4 * closeness
    base_3set = 29 + 3 * closeness
    return (1 - p_3sets) * base_2set + p_3sets * base_3set, p_3sets


def norm_cdf(x, mu, sigma):
    return 0.5 * (1 + math.erf((x - mu) / (sigma * math.sqrt(2))))


def over_prob(line, expected, sigma=3.5):
    return 1 - norm_cdf(line, expected, sigma)


def fair_odds(p):
    p = max(0.02, min(0.98, p))
    return round(1 / p, 2)


def predict(p1, p2, surface):
    r1, r2 = player_rating(p1), player_rating(p2)
    p_elo = elo_prob(r1, r2)

    # Placeholder until H2H endpoint is wired in
    f1, f2 = 0.5, 0.5
    p_form = 0.5

    rk1, rk2 = player_rank(p1), player_rank(p2)
    p_rank = rk2 / (rk1 + rk2) if (rk1 + rk2) else 0.5

    p_set1 = 0.5 * p_elo + 0.5 * p_rank  # placeholder blend

    prob = 0.55 * p_elo + 0.20 * p_form + 0.15 * p_rank + 0.10 * p_set1
    exp_games, p3 = total_games_model(r1 - r2)

    return {
        "prob": prob, "p_elo": p_elo, "p_form": p_form,
        "p_rank": p_rank, "p_set1": p_set1,
        "e1": r1, "e2": r2, "f1": f1, "f2": f2,
        "exp_games": exp_games, "p_3sets": p3,
    }


# ---------- Bzzoiro data loading ----------
def normalize_fixture(m):
    """
    Bzzoiro match list schema (from explorer):
      { id, match_date, player1: {...}, player2: {...},
        round_name, tournament: {...}, status, ... }[reference:4]
    """
    t = m.get("tournament") or {}
    if isinstance(t, dict):
        tour_name = t.get("name") or "Unknown"
        surface = (t.get("surface") or "hard").lower()
    else:
        tour_name = str(t)
        surface = "hard"
    if surface not in SURFACES:
        surface = "hard"

    p1 = m.get("player1") or {}
    p2 = m.get("player2") or {}

    return {
        "id": m.get("id"),
        "tournament": tour_name,
        "round": m.get("round_name") or m.get("round") or "",
        "surface": surface,
        "start_time": m.get("match_date") or "",
        "p1_raw": p1,
        "p2_raw": p2,
        "p1_id": p1.get("id") if isinstance(p1, dict) else None,
        "p2_id": p2.get("id") if isinstance(p2, dict) else None,
    }


def load_matches():
    global fixtures_cache
    if fixtures_cache is not None:
        return fixtures_cache

    try:
        data = bzzoiro_get("/matches/", params={"circuit": "ATP", "limit": 100})
    except Exception as e:
        print(f"Bzzoiro fetch error: {e}")
        fixtures_cache = []
        return []

    raw_list = data.get("results") if isinstance(data, dict) else data
    if not isinstance(raw_list, list):
        raw_list = []

    out = []
    for m in raw_list:
        try:
            fx = normalize_fixture(m)
            if not fx["p1_id"] or not fx["p2_id"]:
                continue
            # Skip doubles by name (Bzzoiro may return team-style names with "/")
            n1 = player_name(fx["p1_raw"])
            n2 = player_name(fx["p2_raw"])
            if "/" in n1 or "/" in n2:
                continue

            if fx["p1_id"] not in player_cache:
                player_cache[fx["p1_id"]] = bzzoiro_get(f"/players/{fx['p1_id']}/")
            if fx["p2_id"] not in player_cache:
                player_cache[fx["p2_id"]] = bzzoiro_get(f"/players/{fx['p2_id']}/")

            p1 = player_cache[fx["p1_id"]] or fx["p1_raw"]
            p2 = player_cache[fx["p2_id"]] or fx["p2_raw"]

            pred = predict(p1, p2, fx["surface"])
            out.append({
                "match": {"id": fx["id"], "tournament": fx["tournament"],
                          "round": fx["round"], "surface": fx["surface"]},
                "p1": {"name": player_name(p1), "ranking": player_rank(p1)},
                "p2": {"name": player_name(p2), "ranking": player_rank(p2)},
                "surface": fx["surface"],
                "pred": pred,
            })
        except Exception as e:
            print(f"Skipping match {m.get('id')}: {e}")
            continue

    fixtures_cache = out
    return out


# ---------- Template (unchanged from working version) ----------
PAGE = """
<!doctype html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Tennis Betting Model</title>
<style>
  :root{
    --bg0:#0a0d1a;--bg2:#1a1f36;
    --fg:#e8eaf2;--dim:#8892b0;--dim2:#b8c0dc;
    --line:rgba(255,255,255,0.08);--line2:rgba(255,255,255,0.04);
    --p1:#7fd4ff;--p1b:#4fa3ff;
    --p2:#a78bfa;--p2b:#8b5cf6;
    --hit:#6ee7b7;--hitbg:rgba(52,211,153,0.13);
    --miss:#94a3b8;--missbg:rgba(148,163,184,0.07);
    --neg:#f87171;--negbg:rgba(248,113,113,0.11);
  }
  *{box-sizing:border-box;margin:0;padding:0}
  body{font-family:-apple-system,"Segoe UI",Roboto,sans-serif;
    background:radial-gradient(circle at top,var(--bg2) 0%,var(--bg0) 60%);
    color:var(--fg);min-height:100vh;padding:26px 14px 60px;
    -webkit-font-smoothing:antialiased}
  .wrap{max-width:680px;margin:0 auto}
  h1{font-size:23px;letter-spacing:-0.4px;
    background:linear-gradient(90deg,var(--p1),var(--p2));
    -webkit-background-clip:text;-webkit-text-fill-color:transparent}
  .sub{color:var(--dim);font-size:12.5px;margin-top:4px}
  .legend{color:#4a5270;font-size:11px;margin:6px 0 20px}
  .legend b{color:var(--dim);font-weight:600}
  .card{background:linear-gradient(180deg,rgba(255,255,255,0.045),rgba(255,255,255,0.012));
    border:1px solid var(--line);border-radius:18px;margin-bottom:14px;overflow:hidden}
  .card-head{padding:16px 18px 14px;border-bottom:1px solid var(--line2)}
  .tourney{font-size:10.5px;letter-spacing:1.4px;text-transform:uppercase;
    color:var(--p1);font-weight:700;margin-bottom:10px;
    display:flex;align-items:center;gap:8px}
  .tourney .dot{width:5px;height:5px;border-radius:50%;background:var(--p1)}
  .matchup{display:grid;grid-template-columns:1fr auto 1fr;gap:10px;align-items:center}
  .side{min-width:0}.side.right{text-align:right}
  .pname{font-size:15.5px;font-weight:600;letter-spacing:-0.2px;
    white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .pmeta{font-size:11px;color:var(--dim);margin-top:3px;font-variant-numeric:tabular-nums}
  .pmeta b{color:var(--dim2);font-weight:600}
  .vs-div{color:#3a4160;font-size:10px;font-weight:800;letter-spacing:1px}
  .pbar{display:flex;height:4px;border-radius:3px;overflow:hidden;
    margin-top:10px;background:rgba(255,255,255,0.05)}
  .pbar .a{background:linear-gradient(90deg,var(--p1),var(--p1b))}
  .pbar .b{background:linear-gradient(90deg,var(--p2),var(--p2b))}
  .market{padding:12px 18px 14px;border-bottom:1px solid var(--line2)}
  .market:last-of-type{border-bottom:none}
  .mkt-title{display:flex;justify-content:space-between;align-items:center;
    font-size:10.5px;letter-spacing:1.4px;text-transform:uppercase;
    color:var(--dim);font-weight:700;margin-bottom:8px;gap:8px}
  .mkt-title .left{display:flex;align-items:center;gap:8px;min-width:0}
  .mkt-title .hint{color:#4a5270;letter-spacing:0;text-transform:none;
    font-weight:500;font-size:11px;white-space:nowrap}
  .mrow{display:grid;grid-template-columns:minmax(0,1fr) 52px 68px 62px;
    align-items:center;gap:8px;padding:5px 0}
  .mrow + .mrow{border-top:1px dashed var(--line2)}
  .label{display:flex;align-items:center;gap:7px;min-width:0}
  .swatch{width:3px;height:14px;border-radius:2px;flex-shrink:0}
  .swatch.p1{background:linear-gradient(180deg,var(--p1),var(--p1b))}
  .swatch.p2{background:linear-gradient(180deg,var(--p2),var(--p2b))}
  .swatch.n{background:linear-gradient(180deg,#64748b,#475569)}
  .lbl-text{font-size:13px;color:var(--fg);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .prob{font-size:12.5px;font-weight:700;text-align:right;font-variant-numeric:tabular-nums}
  input.odds{width:100%;background:rgba(255,255,255,0.05);
    border:1px solid var(--line);color:var(--fg);padding:6px 8px;
