    border-top:1px solid var(--line2)}
  .breakdown{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin-bottom:12px}
  .bd{font-size:10px;color:var(--dim);text-align:center;letter-spacing:0.4px}
  .bd b{display:block;color:var(--dim2);font-size:12.5px;font-weight:700;
    margin-top:2px;font-variant-numeric:tabular-nums}
  button.submit{width:100%;background:linear-gradient(90deg,var(--p1),var(--p2));
    border:none;color:#0a0d1a;font-weight:800;padding:11px;border-radius:10px;
    cursor:pointer;font-size:13px;letter-spacing:0.3px;transition:transform .1s}
  button.submit:active{transform:scale(0.985)}
</style>
</head>
<body>
<div class="wrap">
  <h1>🎾 Tennis Betting Model</h1>
  <p class="sub">{{ matches|length }} ATP matches · odds inline per market · edges auto-checked</p>
  <p class="legend">Grey italic odds = <b>model fair price</b> · type bookmaker odds to see the edge</p>

  {% if matches|length == 0 %}
    <div class="card"><div class="card-head">
      <div class="tourney"><span class="dot"></span>No matches loaded</div>
      <p style="font-size:13px;color:#b8c0dc;line-height:1.5">
        Bzzoiro returned no parseable fixtures. Visit
        <a href="/debug" style="color:#7fd4ff">/debug</a> to see the raw response.
      </p>
    </div></div>
  {% endif %}

  {% for m in matches %}
    {% set s = odds_map.get(m.match.id, {}) %}
    {% set mw1 = s.get('mw1') if s.get('mw1') else m.pred.fair_mw1 %}
    {% set mw2 = s.get('mw2') if s.get('mw2') else m.pred.fair_mw2 %}
    {% set s11 = s.get('s11') if s.get('s11') else m.pred.fair_s11 %}
    {% set s12 = s.get('s12') if s.get('s12') else m.pred.fair_s12 %}
    {% set line = s.get('line') if s.get('line') else m.pred.fair_line %}
    {% set ov = s.get('ov') if s.get('ov') else m.pred.fair_ov %}
    {% set un = s.get('un') if s.get('un') else m.pred.fair_un %}
    {% set is_default = not (s.get('mw1')) %}

    {% set p1p = m.pred.prob %}
    {% set p2p = 1 - p1p %}
    {% set s1p1 = m.pred.p_set1 %}
    {% set s1p2 = 1 - s1p1 %}
    {% set pov = m.pred.p_over %}
    {% set pun = 1 - pov %}

    {% set e_mw1 = p1p - (1/mw1) %}
    {% set e_mw2 = p2p - (1/mw2) %}
    {% set e_s11 = s1p1 - (1/s11) %}
    {% set e_s12 = s1p2 - (1/s12) %}
    {% set e_ov  = pov - (1/ov) %}
    {% set e_un  = pun - (1/un) %}

    <div class="card">
      <div class="card-head">
        <div class="tourney"><span class="dot"></span>{{ m.match.tournament }} · {{ m.surface|title }} · {{ m.match.round }}</div>
        <div class="matchup">
          <div class="side">
            <div class="pname">{{ m.p1.name }}</div>
            <div class="pmeta">Rank <b>#{{ m.p1.ranking }}</b> · Rating <b>{{ '%.0f'|format(m.pred.e1) }}</b></div>
          </div>
          <div class="vs-div">VS</div>
          <div class="side right">
            <div class="pname">{{ m.p2.name }}</div>
            <div class="pmeta">Rank <b>#{{ m.p2.ranking }}</b> · Rating <b>{{ '%.0f'|format(m.pred.e2) }}</b></div>
          </div>
        </div>
        <div class="pbar">
          <div class="a" style="width: {{ p1p*100 }}%"></div>
          <div class="b" style="width: {{ p2p*100 }}%"></div>
        </div>
      </div>

      <form method="post" action="/check/{{ m.match.id }}">
        <div class="market">
          <div class="mkt-title"><span>Match Winner</span>
            <span class="hint">{{ '%.1f'|format(p1p*100) }} / {{ '%.1f'|format(p2p*100) }}</span></div>
          <div class="mrow">
            <div class="label"><span class="swatch p1"></span><span class="lbl-text">{{ m.p1.name }}</span></div>
            <div class="prob">{{ '%.1f'|format(p1p*100) }}%</div>
            <input class="odds {{ 'default' if is_default }}" name="mw1" value="{{ mw1 }}" inputmode="decimal">
            <div class="edge {{ 'hit' if e_mw1>0.03 else ('neg' if e_mw1<-0.03 else 'miss') }}">{{ '%+.1f'|format(e_mw1*100) }}%</div>
          </div>
          <div class="mrow">
            <div class="label"><span class="swatch p2"></span><span class="lbl-text">{{ m.p2.name }}</span></div>
            <div class="prob">{{ '%.1f'|format(p2p*100) }}%</div>
            <input class="odds {{ 'default' if is_default }}" name="mw2" value="{{ mw2 }}" inputmode="decimal">
            <div class="edge {{ 'hit' if e_mw2>0.03 else ('neg' if e_mw2<-0.03 else 'miss') }}">{{ '%+.1f'|format(e_mw2*100) }}%</div>
          </div>
        </div>

        <div class="market">
          <div class="mkt-title"><span>Set 1 Winner</span>
            <span class="hint">{{ '%.1f'|format(s1p1*100) }} / {{ '%.1f'|format(s1p2*100) }}</span></div>
          <div class="mrow">
            <div class="label"><span class="swatch p1"></span><span class="lbl-text">{{ m.p1.name }}</span></div>
            <div class="prob">{{ '%.1f'|format(s1p1*100) }}%</div>
            <input class="odds {{ 'default' if is_default }}" name="s11" value="{{ s11 }}" inputmode="decimal">
            <div class="edge {{ 'hit' if e_s11>0.03 else ('neg' if e_s11<-0.03 else 'miss') }}">{{ '%+.1f'|format(e_s11*100) }}%</div>
          </div>
          <div class="mrow">
            <div class="label"><span class="swatch p2"></span><span class="lbl-text">{{ m.p2.name }}</span></div>
            <div class="prob">{{ '%.1f'|format(s1p2*100) }}%</div>
            <input class="odds {{ 'default' if is_default }}" name="s12" value="{{ s12 }}" inputmode="decimal">
            <div class="edge {{ 'hit' if e_s12>0.03 else ('neg' if e_s12<-0.03 else 'miss') }}">{{ '%+.1f'|format(e_s12*100) }}%</div>
          </div>
        </div>

        <div class="market">
          <div class="mkt-title">
            <span class="left">Total Games · line <input class="odds line" name="line" value="{{ line }}" inputmode="decimal"></span>
            <span class="hint">exp {{ '%.1f'|format(m.pred.exp_games) }} · 3-set {{ '%.0f'|format(m.pred.p_3sets*100) }}%</span>
          </div>
          <div class="mrow">
            <div class="label"><span class="swatch n"></span><span class="lbl-text">Over</span></div>
            <div class="prob">{{ '%.1f'|format(pov*100) }}%</div>
            <input class="odds {{ 'default' if is_default }}" name="ov" value="{{ ov }}" inputmode="decimal">
            <div class="edge {{ 'hit' if e_ov>0.03 else ('neg' if e_ov<-0.03 else 'miss') }}">{{ '%+.1f'|format(e_ov*100) }}%</div>
          </div>
          <div class="mrow">
            <div class="label"><span class="swatch n"></span><span class="lbl-text">Under</span></div>
            <div class="prob">{{ '%.1f'|format(pun*100) }}%</div>
            <input class="odds {{ 'default' if is_default }}" name="un" value="{{ un }}" inputmode="decimal">
            <div class="edge {{ 'hit' if e_un>0.03 else ('neg' if e_un<-0.03 else 'miss') }}">{{ '%+.1f'|format(e_un*100) }}%</div>
          </div>
        </div>

        <div class="card-foot">
          <div class="breakdown">
            <div class="bd">RATING<b>{{ '%.0f'|format(m.pred.p_elo*100) }}%</b></div>
            <div class="bd">Form<b>{{ '%.0f'|format(m.pred.p_form*100) }}%</b></div>
            <div class="bd">Rank<b>{{ '%.0f'|format(m.pred.p_rank*100) }}%</b></div>
            <div class="bd">Set 1<b>{{ '%.0f'|format(m.pred.p_set1*100) }}%</b></div>
          </div>
          <button class="submit" type="submit">Save odds &amp; recompute edges</button>
        </div>
      </form>
    </div>
  {% endfor %}
</div>
</body>
</html>
"""


# ---------- Routes ----------
def build_matches_with_markets():
    matches = load_matches()
    saved_all = load_all_odds()
    for m in matches:
        saved = saved_all.get(m["match"]["id"], {})
        line = saved.get("line") or math.floor(m["pred"]["exp_games"]) + 0.5
        m["pred"]["p_over"] = over_prob(line, m["pred"]["exp_games"])
        m["pred"]["line_used"] = line
        p = m["pred"]
        p["fair_mw1"] = fair_odds(p["prob"])
        p["fair_mw2"] = fair_odds(1 - p["prob"])
        p["fair_s11"] = fair_odds(p["p_set1"])
        p["fair_s12"] = fair_odds(1 - p["p_set1"])
        p["fair_ov"] = fair_odds(p["p_over"])
        p["fair_un"] = fair_odds(1 - p["p_over"])
        p["fair_line"] = round(line * 2) / 2
    return matches


@app.route("/")
def index():
    try:
        matches = build_matches_with_markets()
    except Exception as e:
        return f"<pre style='color:#f87171;padding:24px'>Error: {e}</pre>", 500
    return render_template_string(PAGE, matches=matches, odds_map=load_all_odds())


@app.route("/debug")
def debug():
    out = {"base_url": BZZOIRO_BASE, "token_set": bool(BZZOIRO_TOKEN)}
    try:
        raw = bzzoiro_get("/matches/", params={"circuit": "ATP", "limit": 5})
        out["matches_response_type"] = type(raw).__name__
        sample = raw.get("results") if isinstance(raw, dict) else raw
        out["count"] = raw.get("count") if isinstance(raw, dict) else None
        out["matches_sample"] = (sample or [])[:2]
        if sample:
            first_id = sample[0].get("id")
            if first_id:
                out["match_detail_sample"] = bzzoiro_get(f"/matches/{first_id}/")
                out["h2h_sample"] = bzzoiro_get(f"/matches/{first_id}/h2h/")
            p1 = (sample[0].get("player1") or {})
            pid = p1.get("id") if isinstance(p1, dict) else None
            if pid:
                out["player_sample"] = bzzoiro_get(f"/players/{pid}/")
    except Exception as e:
        out["error"] = str(e)
    return ("<pre style='color:#e8eaf2;background:#0a0d1a;padding:20px;"
            "white-space:pre-wrap;word-break:break-word;font-size:12px'>"
            f"{json.dumps(out, indent=2, default=str)}</pre>")


@app.route("/check/<int:match_id>", methods=["POST"])
def check(match_id):
    def num(name, default):
        try:
            return float(request.form.get(name, default) or default)
        except ValueError:
            return default

    save_odds(match_id,
              mw1=num("mw1", 1.80), mw2=num("mw2", 2.00),
              s11=num("s11", 1.90), s12=num("s12", 1.90),
              line=num("line", 22.5),
              ov=num("ov", 1.90), un=num("un", 1.90))

    matches = build_matches_with_markets()
    return render_template_string(PAGE, matches=matches, odds_map=load_all_odds())


if __name__ == "__main__":
    ensure_schema()
    port = int(os.environ.get("PORT", 5000))
    app.run(host="0.0.0.0", port=port, debug=False)
