#!/data/data/com.termux/files/usr/bin/bash
# Runs every day at 6:00 AM GMT+3
cd ~/tennis_model

# Log everything
LOG=~/tennis_model/logs/refresh_$(date +%Y%m%d).log
mkdir -p ~/tennis_model/logs

echo "=== Refresh started at $(date) ===" >> "$LOG"

# 1. Clear caches that expire daily
rm -f rankings.json

# 2. Refresh Elo dataset (only new months — preserves existing files)
export LIVETENNISAPI_KEY=twjp_1278d845735622c3f5d02bb076dbff95
python -c "
import dataset
matches = dataset.load_all_matches()
print(f'Loaded {len(matches)} matches')
" >> "$LOG" 2>&1

# 3. Refresh form cache (clears stale form data)
rm -f form.json

# 4. Restart the Flask app if it's running
pkill -f "python app.py" 2>/dev/null
sleep 2
nohup python app.py >> "$LOG" 2>&1 &

echo "=== Refresh complete at $(date) ===" >> "$LOG"

# Keep only last 7 logs
ls -t ~/tennis_model/logs/refresh_*.log | tail -n +8 | xargs rm -f 2>/dev/null
