    text-align:right;font-family:inherit;transition:border-color .15s,background .15s}
  input.odds:focus{outline:none;border-color:rgba(127,212,255,0.55);
    background:rgba(127,212,255,0.07)}
  input.odds.default{color:#94a3b8;font-style:italic}
  input.odds.line{width:52px;padding:3px 6px;font-size:11.5px;
