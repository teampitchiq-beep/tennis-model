#!/data/data/com.termux/files/usr/bin/bash
# Runs every day at 6:00 AM GMT+3
cd ~/tennis_model || exit 1

LOG=~/tennis_model/logs/refresh_$(date +%Y%m%d).log
mkdir -p ~/tennis_model/logs
echo "=== Refresh started at $(date) ===" >> "$LOG"

# Secrets live in ~/tennis_model/.env (git-ignored), never in this script:
#   LIVETENNISAPI_KEY=...
if [ -f .env ]; then set -a; . ./.env; set +a; fi

# 1. Clear caches that expire daily
rm -f rankings.json

# 2. Refresh the archive (current-year files re-download from upstream first),
#    then pull every finished match since the archive ends, so Elo is current.
#    (Ratings 4.5 months stale cost ~0.027 log loss in backtests.)
python -c "
import dataset
m = dataset.load_all_matches()
print(f'Loaded {len(m)} matches, newest {m[-1][\"_date\"].date()}')
" >> "$LOG" 2>&1
python recent.py >> "$LOG" 2>&1

# 3. Weekly (Sunday): re-evaluate on held-out data and refit the blend weights
if [ "$(date +%u)" = "7" ]; then
  python evaluate.py >> "$LOG" 2>&1
fi

# 4. Refresh form cache (display only)
rm -f form.json

# 5. Restart the Flask app
pkill -f "python app.py" 2>/dev/null
sleep 2
nohup python app.py >> "$LOG" 2>&1 &

echo "=== Refresh complete at $(date) ===" >> "$LOG"

# Keep only last 7 logs
ls -t ~/tennis_model/logs/refresh_*.log | tail -n +8 | xargs rm -f 2>/dev/null
